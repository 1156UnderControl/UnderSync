{
  "name": "undersync",
  "version": "0.1.0",
  "private": true,
  "description": "UnderSync robotics-team operations application.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit false --outDir dist",
    "dev": "npm run build && node --env-file-if-exists=.env --watch dist/src/server.js",
    "start": "npm run build && node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:seed": "prisma db seed",
    "db:validate": "prisma validate",
    "test:db": "node --env-file-if-exists=.env scripts/run-database-tests.mjs"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "express": "^5.1.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "8.16.0",
    "prisma": "7.9.1",
    "typescript": "^5.9.2"
  }
}
