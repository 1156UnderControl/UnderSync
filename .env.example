# Copy these local-development settings into the ignored .env file.
PORT=8000

# Local PostgreSQL container. Choose a strong local-only password in .env.
POSTGRES_DB=undersync_dev
POSTGRES_USER=undersync
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Keep credentials aligned with POSTGRES_* above. The test runner refuses to
# reset a database unless its name ends in "_test".
DATABASE_URL=postgresql://undersync:replace-with-a-local-development-password@localhost:5432/undersync_dev?schema=public
TEST_DATABASE_URL=postgresql://undersync:replace-with-a-local-development-password@localhost:5432/undersync_test?schema=public

# Application authentication
SESSION_TTL_HOURS=168
# Required for the Onshape cross-site iframe. localhost is treated as a secure
# context by supported browsers; deployed environments must use HTTPS.
COOKIE_SECURE=true

# Onshape OAuth. The Redirect URL must exactly match the one registered in Onshape.
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
ONSHAPE_REDIRECT_URI=http://localhost:8000/oauth/callback
ONSHAPE_AUTHORIZATION_URL=https://oauth.onshape.com/oauth/authorize
ONSHAPE_TOKEN_URL=https://oauth.onshape.com/oauth/token
ONSHAPE_API_BASE_URL=https://cad.onshape.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this outside the database and back it up securely; changing it invalidates stored grants.
INTEGRATION_ENCRYPTION_KEY=
