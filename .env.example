# Convex + Vite (active architecture)
# Do not copy a real deployment name or URL into this tracked file. Running
# `npx convex dev` writes the real development values to ignored `.env.local`.
CONVEX_DEPLOYMENT=dev:your-development-deployment
VITE_CONVEX_URL=https://your-development-deployment.convex.cloud
# Generated for future Convex HTTP actions; currently unused by the frontend.
VITE_CONVEX_SITE_URL=https://your-development-deployment.convex.site

# Vercel only: configure CONVEX_DEPLOY_KEY in the Vercel dashboard. It is used
# during the build and must never have a VITE_ prefix or be exposed to browsers.
CONVEX_DEPLOY_KEY=

# Legacy Express + PostgreSQL compatibility only. These values are not used by
# the active Vite frontend or Convex backend. Copy them to the ignored `.env`
# file only when running one of the legacy:* scripts.
# Bind on every network interface so localhost, LAN, and forwarded traffic can
# reach the web application. Do not expose the PostgreSQL port.
HOST=0.0.0.0
PORT=8000

# Local PostgreSQL container. Choose a strong local-only password in .env.
POSTGRES_DB=undersync_dev
POSTGRES_USER=undersync
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Keep credentials aligned with POSTGRES_* above. The test runner refuses to
# reset a database unless its name ends in "_test".
DATABASE_URL=postgresql://undersync:replace-with-a-local-development-password@localhost:5432/undersync_dev?schema=public
TEST_DATABASE_URL=postgresql://undersync:replace-with-a-local-development-password@localhost:5432/undersync_test?schema=public

# Application authentication
SESSION_TTL_HOURS=168
# Required for the Onshape cross-site iframe. localhost is treated as a secure
# context by supported browsers; deployed environments must use HTTPS.
COOKIE_SECURE=true

# Onshape OAuth. The Redirect URL must exactly match the one registered in Onshape.
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
ONSHAPE_REDIRECT_URI=http://localhost:8000/oauth/callback
ONSHAPE_AUTHORIZATION_URL=https://oauth.onshape.com/oauth/authorize
ONSHAPE_TOKEN_URL=https://oauth.onshape.com/oauth/token
ONSHAPE_API_BASE_URL=https://cad.onshape.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this outside the database and back it up securely; changing it invalidates stored grants.
INTEGRATION_ENCRYPTION_KEY=
